flowchart TD
    %% 定义节点样式
    classDef process fill:#e1f5fe,stroke:#01579b,stroke-width:2px,rx:5,ry:5;
    classDef decision fill:#fff9c4,stroke:#fbc02d,stroke-width:2px,rx:5,ry:5,shape:rhombus;
    classDef state fill:#ffe0b2,stroke:#f57c00,stroke-width:2px,rx:5,ry:5;
    classDef error fill:#ffcdd2,stroke:#c62828,stroke-width:2px,stroke-dasharray: 5 5;
    classDef parallel fill:#e0f2f1,stroke:#00695c,stroke-width:2px;
    classDef endnode fill:#cfd8dc,stroke:#455a64,stroke-width:2px,shape:circle;

    Start((开始)) --> Init[初始化 Tracer 和 变量]:::process
    
    %% 阶段 1: 分析
    subgraph Stage1_Analysis ["阶段1 问题分析"]
        direction TB
        TryAnalysis[尝试分析问题并给出计划：解决该问题需要的所有事实信息需求列表]:::process
        CheckAnalysis{"分析成功?"}:::decision
        RetryAnalysis[重试次数 +1]:::error
        
        Init --> TryAnalysis
        TryAnalysis --> CheckAnalysis
        CheckAnalysis -- 否 --> RetryAnalysis
        RetryAnalysis -->|未超限| TryAnalysis
        RetryAnalysis -->|超限| ErrorExit((报错退出)):::endnode
    end

    %% 初始化状态
    CheckAnalysis -- 是 --> InitState[根据初始的规划开始工作]:::state
    InitState --> LoopCheck

    %% 阶段 2 和 3: 循环迭代
    subgraph MainLoop ["主循环引擎 Stage 2 和 3"]
        direction TB
        LoopCheck{"检查循环条件<br>1. 次数未超限?<br>2. 还有待办任务?"}:::decision
        
        %% 状态快照 (核心机制)
        Snapshot["📸 保存推理进度：备份 facts 和 requirements"]:::state
        
        LoopCheck -- 是 --> Snapshot
        
        %% 规划步骤
        PlanningCheck{"上一次事实抽取是否使得所有未解决的事实需求得到解决？<br>last_extraction_direct?"}:::decision
        Snapshot --> PlanningCheck
        
        PlanLite[更新计划: 更新计划表的状态,并评估事实是否充分,是否可以结束]:::process
        PlanHeavy[重规划: 诊断故障范围区分局部问题（如查询表述不当）与系统缺陷（如无关推理路径）,并重新生成计划]:::process
        
        PlanningCheck -- 是 --> PlanLite
        PlanningCheck -- 否 --> PlanHeavy
        
        CheckPlanResult{"决策下一步?"}:::decision
        PlanLite --> CheckPlanResult
        PlanHeavy --> CheckPlanResult
        
        %% 规划的分支
        CheckPlanResult -- SYNTHESIZE --> BreakLoop[跳出循环]:::process
        CheckPlanResult -- CONTINUE --> ThreadPoolStart
        
        %% 线程池并行执行
        subgraph ThreadPool ["线程池 ThreadPoolExecutor"]
            direction TB
            ThreadPoolStart[针对计划表中每一个对事实的需求开始分发事实提取任务]:::parallel
            Task1[线程1: retrieve_and_extract]:::parallel
            Task2[线程2: retrieve_and_extract]:::parallel
            Task3[线程3: retrieve_and_extract]:::parallel
            
            ThreadPoolStart --> Task1 & Task2 & Task3
        end
        
        %% 结果收集与错误处理
        CollectResults{"1.过程中有没有出现错误？<br>2.事实结果是否完全满足了所有当前的需求？"}:::decision
        Task1 & Task2 & Task3 --> CollectResults
        
        %% 异常回滚路径 (红色虚线)
        Rollback["❌ 触发回滚<br>1. 恢复到存档点<br>2. 丢弃 Tracer 日志"]:::error
        CollectResults -- 有异常 --> Rollback
        Rollback -.->|重试本轮| LoopCheck
        
        %% 成功更新状态
        UpdateState["✅ 更新状态<br>1. 添加新事实<br>2. 移除已完成需求<br>3. 提交 Tracer 日志<br>4. 如果过程成功,则设置last_extraction_direct=True。如果过程失败,设置变量为False"]:::state
        CollectResults -- 过程成功 --> UpdateState
        UpdateState -->|计数器+1| LoopCheck
    end

    %% 阶段 4: 合成
    subgraph Stage4_Synthesis ["阶段4 最终合成"]
        Synthesize[合成答案: synthesize_final_answer]:::process
    end

    LoopCheck -- 否 或 跳出 --> Synthesize
    BreakLoop --> Synthesize
    
    Synthesize --> End((结束)):::endnode

    %% 连接样式
    linkStyle default stroke:#333,stroke-width:1px;